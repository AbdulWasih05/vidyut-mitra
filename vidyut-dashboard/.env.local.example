.# Copy to .env.local (gitignored) and fill in.
# Both vars must be NEXT_PUBLIC_ prefixed so the browser bundle can read them.

# Flask admin API base URL. Defaults to http://localhost:5001/admin if unset.
NEXT_PUBLIC_ADMIN_API=http://localhost:5001/admin

# Must match ADMIN_PASSWORD in the repo-root .env (the Flask server's env).
# Demo-day secret only — rotate after the pitch.
NEXT_PUBLIC_ADMIN_PASSWORD=
