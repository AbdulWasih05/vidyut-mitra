# VidyutMitra environment template. Copy to .env and fill in real values.
# NEVER commit the real .env file.

# --- Gemini 2.5 Flash (vision extraction) ---
GEMINI_API_KEY=

# --- Groq (Llama 3.3 70B for AI-framed analysis replies) ---
# Optional: if absent, the app falls back to fully templated responses.
GROQ_API_KEY=

# --- Twilio WhatsApp Sandbox ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=

# --- Sarvam (Kannada TTS) ---
SARVAM_API_KEY=


# --- App runtime ---
FLASK_ENV=development
PUBLIC_BASE_URL=http://localhost:5000
